# Copy to .env.docker.prod on the production host. Never commit real secrets.
# Pooled Neon Cloud URL. Keep TLS certificate verification enabled.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Direct endpoint for migrations, without -pooler.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
JWT_SECRET=
JWT_EXPIRES_IN=1h
ARCJET_KEY=
ARCJET_TRUSTED_PROXIES=
LOG_LEVEL=info
APP_IMAGE=acquisitions:production
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Optional: a random secret enabling admin signup; blank disables it.
ADMIN_SIGNUP_KEY=

# Public origin used in verification/reset links. HTTPS required in production.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
