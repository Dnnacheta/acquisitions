# Copy to .env.docker.dev. Use a dedicated existing development branch.
NEON_API_KEY=
NEON_PROJECT_ID=
BRANCH_ID=
NEON_DATABASE_NAME=neondb
APP_PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=1h
ARCJET_KEY=
LOG_LEVEL=info
# Leave unset to use the tested digest in compose.dev.yaml.
# NEON_LOCAL_IMAGE=neondatabase/neon_local:latest

# Optional: a random secret enabling admin signup; blank disables it.
ADMIN_SIGNUP_KEY=

# Mailpit inbox: http://localhost:8025 (messages stay local).
MAILPIT_PORT=8025
MAIL_FROM=Acquisitions <noreply@example.test>
# Optional override; defaults to http://localhost:${APP_PORT}
APP_BASE_URL=
