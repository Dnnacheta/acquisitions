# server config
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Config
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# JWT configuration: use a randomly generated secret of at least 32 bytes
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Arcjet site key from https://console.arcjet.com
ARCJET_KEY=
# Set only for local development; omit in production.
ARCJET_ENV=development
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct connections.
ARCJET_TRUSTED_PROXIES=
